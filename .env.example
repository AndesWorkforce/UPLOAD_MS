# .env.example
# Archivo de ejemplo para variables de entorno del Upload Microservice
# Copia este archivo a .env y completa con tus valores reales

# ======================
# AWS S3 Configuration
# ======================
AWS_REGION=us-east-2
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ======================
# Server Configuration
# ======================
PORT=3006

# ======================
# Timezone
# ======================
TZ=America/New_York

# ======================
# NATS Configuration
# ======================
NATS_HOST=localhost
NATS_PORT=4222
NATS_USERNAME=your-nats-username
NATS_PASSWORD=your-nats-password

# ======================
# Security
# ======================
JWT_SECRET_PASSWORD=your-jwt-secret

# ======================
# Application Settings
# ======================
DEV_LOGS=true
ENVIRONMENT=development

# ======================
# ADT Microservice
# ======================
ADT_MS_URL=http://localhost:3002