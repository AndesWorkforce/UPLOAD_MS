<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Individual Productivity Report</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
      font-family: Arial, sans-serif; 
      padding: 32px; 
      color: #000000;
      background: #FFFFFF;
    }

    /* Header */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 2px solid #0097B2;
    }
    .header h1 { 
      font-size: 24px;
      font-weight: 600;
      color: #000000;
    }

    /* Contractor Info Card */
    .contractor-info {
      background: #FFFFFF;
      border: 1px solid rgba(166,166,166,0.5);
      border-radius: 5px;
      padding: 20px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 15px;
    }
    .contractor-info .avatar {
      width: 55px;
      height: 55px;
      background: #F3F4F6;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      color: #9CA3AF;
    }
    .contractor-info .info {
      flex: 1;
    }
    .contractor-info .name {
      font-size: 20px;
      font-weight: 600;
      color: #000000;
      margin-bottom: 4px;
    }
    .contractor-info .details {
      font-size: 14px;
      color: #000000;
    }

    /* Period Info */
    .period-info {
      background: #F8FAFC;
      border: 1px solid rgba(166,166,166,0.5);
      border-radius: 5px;
      padding: 12px 16px;
      margin-bottom: 20px;
      font-size: 14px;
      color: #6D6D6D;
      text-align: center;
    }

    /* Metrics Grid */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-bottom: 20px;
    }

    /* Input Totals */
    .input-card {
      background: #FFFFFF;
      border: 1px solid rgba(166,166,166,0.25);
      border-radius: 5px;
      padding: 15px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .input-card .icon {
      font-size: 32px;
    }
    .input-card .info {
      flex: 1;
    }
    .input-card .label {
      font-size: 12px;
      font-weight: 300;
      color: #000000;
      margin-bottom: 4px;
    }
    .input-card .value {
      font-size: 20px;
      font-weight: 600;
      color: #000000;
    }

    /* Top Lists (Apps/Websites) */
    .top-list-card {
      background: #FFFFFF;
      border: 1px solid rgba(166,166,166,0.5);
      border-radius: 5px;
      padding: 20px;
      margin-bottom: 20px;
    }
    .top-list-card .title {
      font-size: 16px;
      font-weight: 600;
      color: #000000;
      margin-bottom: 15px;
    }
    .top-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid rgba(166,166,166,0.15);
    }
    .top-item:last-child {
      border-bottom: none;
    }
    .top-item .name {
      font-size: 14px;
      color: #000000;
      flex: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .top-item .time {
      font-size: 14px;
      font-weight: 600;
      color: #0097B2;
      margin-left: 10px;
    }

    /* Usage Distribution */
    .usage-distribution {
      margin-top: 20px;
      padding-top: 15px;
      border-top: 1px solid rgba(166,166,166,0.15);
    }
    .usage-distribution .subtitle {
      font-size: 12px;
      font-weight: 600;
      color: #000000;
      margin-bottom: 10px;
    }
    .distribution-bar {
      height: 8px;
      width: 100%;
      border-radius: 4px;
      display: flex;
      overflow: hidden;
      margin-bottom: 12px;
    }
    .distribution-segment {
      height: 100%;
    }
    .distribution-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    .legend-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }
    .legend-label {
      font-size: 12px;
      font-weight: 500;
      color: #000000;
    }

    /* Time Breakdown */
    .time-breakdown {
      background: #FFFFFF;
      border: 1px solid rgba(166,166,166,0.5);
      border-radius: 5px;
      padding: 20px;
      margin-bottom: 20px;
    }
    .time-breakdown .title {
      font-size: 16px;
      font-weight: 600;
      color: #000000;
      margin-bottom: 15px;
    }
    .time-breakdown .stats {
      display: flex;
      justify-content: space-between;
      gap: 15px;
    }
    .time-breakdown .stat {
      flex: 1;
      text-align: center;
    }
    .time-breakdown .stat .value {
      font-size: 20px;
      font-weight: 600;
      color: #000000;
      margin-bottom: 8px;
    }
    .time-breakdown .stat .label {
      font-size: 12px;
      font-weight: 300;
      color: #000000;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    .time-breakdown .stat .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }
    .time-breakdown .stat.active .dot { background: #0097B2; }
    .time-breakdown .stat.idle .dot { background: #FF0004; }

    /* Session & Connectivity */
    .session-connectivity {
      background: #FFFFFF;
      border: 1px solid rgba(166,166,166,0.5);
      border-radius: 5px;
      padding: 20px;
      margin-bottom: 20px;
    }
    .session-connectivity .title {
      font-size: 16px;
      font-weight: 600;
      color: #000000;
      margin-bottom: 15px;
    }
    .charts-grid {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .chart-container {
      position: relative;
      height: 250px;
    }
    .chart-title {
      font-size: 14px;
      font-weight: 500;
      color: #000000;
      margin-bottom: 10px;
      text-align: center;
    }

    /* Session Summary */
    .session-summary {
      background: #FFFFFF;
      border: 1px solid rgba(166,166,166,0.5);
      border-radius: 5px;
      padding: 20px;
      margin-bottom: 20px;
    }
    .session-summary .title {
      font-size: 16px;
      font-weight: 600;
      color: #000000;
      margin-bottom: 8px;
    }
    .session-summary .day-group {
      margin-bottom: 25px;
    }
    .session-summary .day-group:last-child {
      margin-bottom: 0;
    }
    .session-summary .day-header {
      font-size: 14px;
      font-weight: 500;
      color: #000000;
      margin-bottom: 12px;
    }

    /* Table */
    table { 
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }
    thead {
      background: rgba(166,166,166,0.1);
    }
    th {
      padding: 12px;
      text-align: left;
      font-size: 12px;
      font-weight: 600;
      color: #000000;
      border-bottom: 1px solid rgba(166,166,166,0.25);
    }
    td {
      padding: 12px;
      font-size: 12px;
      color: #000000;
      border-bottom: 1px solid rgba(166,166,166,0.15);
    }
    tbody tr:last-child td {
      border-bottom: none;
    }

    /* Footer */
    .footer {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid rgba(166,166,166,0.25);
      text-align: center;
      font-size: 10px;
      color: #6D6D6D;
    }
  </style>
</head>
<body>
  <!-- Header -->
  <div class="header">
    <h1>Individual Productivity Report</h1>
    <div style="font-size: 14px; color: #6D6D6D;">
      {{periodStart}} - {{periodEnd}}
    </div>
  </div>

  <!-- Contractor Info Card -->
  <div class="contractor-info">
    <div class="avatar">👤</div>
    <div class="info">
      <div class="name">{{contractor.name}}</div>
      <div class="details">
        {{contractor.jobPosition}} | Team {{contractor.teamName}} | Client {{contractor.clientName}}
        {{#if contractor.country}} | {{contractor.country}}{{/if}}
      </div>
    </div>
  </div>

  <!-- Period Info -->
  <div class="period-info">
    Report Period: {{periodStart}} to {{periodEnd}}
  </div>

  <!-- Session & Connectivity -->
  {{#if hasChartData}}
  <div class="session-connectivity">
    <div class="title">Session & Connectivity</div>
    <div class="charts-grid">
      <div>
        <div class="chart-title">Avg. Duration</div>
        <div class="chart-container">
          <canvas id="durationChart"></canvas>
        </div>
      </div>
      <div>
        <div class="chart-title">Productivity Score</div>
        <div class="chart-container">
          <canvas id="productivityChart"></canvas>
        </div>
      </div>
    </div>
  </div>
  {{/if}}

  <!-- Input Totals -->
  <div class="metrics-grid">
    <div class="input-card">
      <div class="icon">⌨️</div>
      <div class="info">
        <div class="label">Keyboard Inputs</div>
        <div class="value">{{formatNumber metrics.totalKeyboardInputs}}</div>
      </div>
    </div>
    <div class="input-card">
      <div class="icon">🖱️</div>
      <div class="info">
        <div class="label">Mouse Clicks</div>
        <div class="value">{{formatNumber metrics.totalMouseClicks}}</div>
      </div>
    </div>
  </div>

  <!-- Top Applications -->
  {{#if topApps.length}}
  <div class="top-list-card">
    <div class="title">Top Applications</div>
    {{#each topApps}}
    <div class="top-item">
      <div class="name">{{appName}}</div>
      <div class="time">{{percentage}}%</div>
    </div>
    {{/each}}

    {{#if usageDistribution.length}}
    <div class="usage-distribution">
      <div class="subtitle">Usage Distribution</div>
      <div class="distribution-bar">
        {{#each usageDistribution}}
        <div class="distribution-segment" style="background-color: {{color}}; width: {{percentage}}%;"></div>
        {{/each}}
      </div>
      <div class="distribution-legend">
        {{#each usageDistribution}}
        <div class="legend-item">
          <div class="legend-dot" style="background-color: {{color}};"></div>
          <div class="legend-label">{{type}} ({{percentage}}%)</div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}
  </div>
  {{/if}}

  <!-- Top Websites -->
  {{#if topWebsites.length}}
  <div class="top-list-card">
    <div class="title">Top Websites</div>
    {{#each topWebsites}}
    <div class="top-item">
      <div class="name">{{domain}}</div>
      <div class="time">{{percentage}}%</div>
    </div>
    {{/each}}
  </div>
  {{/if}}

  <!-- Time Breakdown -->
  <div class="time-breakdown">
    <div class="title">Time Breakdown</div>
    <div class="stats">
      <div class="stat">
        <div class="value">{{avgDuration}}</div>
        <div class="label">Total Time</div>
      </div>
      <div class="stat active">
        <div class="value">{{avgActiveTime}}</div>
        <div class="label">
          <span class="dot"></span>
          Active Time
        </div>
      </div>
      <div class="stat idle">
        <div class="value">{{avgIdleTime}}</div>
        <div class="label">
          <span class="dot"></span>
          Inactive Time
        </div>
      </div>
    </div>
  </div>

  <!-- Session Summary -->
  {{#if sessionsByDay.length}}
  <div class="session-summary">
    <div class="title">Session Summary</div>
    {{#each sessionsByDay}}
    <div class="day-group">
      <div class="day-header">{{session_day}}</div>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Duration</th>
            <th>Active</th>
            <th>Idle</th>
            <th>Productivity</th>
          </tr>
        </thead>
        <tbody>
          {{#each sessions}}
          <tr>
            <td>{{index}}</td>
            <td>{{session_start}}</td>
            <td>{{session_end}}</td>
            <td style="font-weight: 600;">{{formatSecondsToTime total_seconds}}</td>
            <td>{{formatSecondsToTime active_seconds}}</td>
            <td>{{formatSecondsToTime idle_seconds}}</td>
            <td style="font-weight: 600; color: #0097B2;">{{productivity_score}}%</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{/each}}
  </div>
  {{/if}}

  <!-- Footer -->
  <div class="footer">
    Generated on {{generatedAt}} | Environment: {{summary.environment}} | Source: {{summary.source}}
  </div>

  {{#if hasChartData}}
  <script>
    // Initialize Chart.js for Duration Chart
    document.addEventListener('DOMContentLoaded', function() {
      const durationCtx = document.getElementById('durationChart');
      const productivityCtx = document.getElementById('productivityChart');

      if (durationCtx && {{{hasDurationData}}}) {
        new Chart(durationCtx, {
          type: 'line',
          data: {
            labels: {{{chartLabels}}},
            datasets: [{
              label: 'Avg. Duration',
              data: {{{durationChartValues}}},
              borderColor: '#0097B2',
              backgroundColor: 'rgba(0, 151, 178, 0.1)',
              borderWidth: 2,
              fill: true,
              tension: 0.3,
              pointRadius: 4,
              pointBackgroundColor: '#0097B2',
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    return 'Duration: ' + context.parsed.y.toFixed(2) + 'h';
                  }
                }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                title: { display: true, text: 'Hours' }
              },
              x: {
                title: { display: true, text: 'Time' }
              }
            }
          }
        });
      }

      if (productivityCtx && {{{hasProductivityData}}}) {
        new Chart(productivityCtx, {
          type: 'line',
          data: {
            labels: {{{chartLabels}}},
            datasets: [{
              label: 'Productivity',
              data: {{{productivityChartValues}}},
              borderColor: '#7DA40A',
              backgroundColor: 'rgba(125, 164, 10, 0.1)',
              borderWidth: 2,
              fill: true,
              tension: 0.3,
              pointRadius: 4,
              pointBackgroundColor: '#7DA40A',
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    return 'Productivity: ' + context.parsed.y.toFixed(0) + '%';
                  }
                }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                max: 100,
                title: { display: true, text: 'Productivity %' }
              },
              x: {
                title: { display: true, text: 'Time' }
              }
            }
          }
        });
      }
    });
  </script>
  {{/if}}
</body>
</html>
