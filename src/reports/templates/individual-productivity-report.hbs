<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Detalle de Reporte</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: Arial, Helvetica, sans-serif;
      padding: 28px;
      color: #000000;
      background: #FFFFFF;
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      padding-bottom: 14px;
      border-bottom: 2px solid #0097B2;
    }
    .header h1 {
      font-size: 22px;
      font-weight: 600;
    }
    .header .period {
      font-size: 13px;
      color: #6D6D6D;
    }

    .card {
      background: #FFFFFF;
      border: 1px solid rgba(166,166,166,0.5);
      border-radius: 5px;
      padding: 18px 20px;
      margin-bottom: 16px;
      max-width: 100%;
      overflow: hidden;
    }

    .contractor-info {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .contractor-info .avatar {
      width: 55px;
      height: 55px;
      background: #F3F4F6;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      color: #9CA3AF;
      flex-shrink: 0;
    }
    .contractor-info .name {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 4px;
    }
    .contractor-info .details {
      font-size: 13px;
      color: #000000;
    }

    .section-title {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 14px;
    }

    /* Input Totals — título arriba, métricas en fila */
    .input-totals-row {
      display: flex;
      gap: 12px;
    }
    .input-metric {
      flex: 1;
      border: 1px solid rgba(166,166,166,0.25);
      border-radius: 5px;
      padding: 12px;
      min-height: 63px;
    }
    .input-metric .label {
      font-size: 12px;
      font-weight: 300;
      margin-bottom: 4px;
    }
    .input-metric .value {
      font-size: 20px;
      font-weight: 600;
    }

    /* Session & Connectivity KPIs */
    .kpi-row {
      display: flex;
      gap: 10px;
      margin-bottom: 16px;
    }
    .kpi {
      flex: 1;
      border: 1px solid rgba(166,166,166,0.5);
      border-radius: 5px;
      padding: 14px;
    }
    .kpi.duration { background: #e8f4f6; border-color: rgba(166,166,166,0.3); }
    .kpi.productivity { background: rgba(125,164,10,0.15); }
    .kpi .label {
      font-size: 13px;
      color: #6D6D6D;
      margin-bottom: 4px;
    }
    .kpi .value {
      font-size: 20px;
      font-weight: 700;
    }

    .charts-grid {
      display: flex;
      flex-direction: column;
      gap: 20px;
      width: 100%;
      max-width: 100%;
      overflow: hidden;
    }
    .chart-title {
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 8px;
    }
    .chart-container {
      height: 220px;
      position: relative;
      width: 100%;
      max-width: 100%;
      overflow: hidden;
    }
    .chart-container canvas {
      max-width: 100% !important;
      width: 100% !important;
    }

    /* Top Sites & Apps — 1 columna en PDF (la web sigue en 2) */
    .apps-grid {
      display: flex !important;
      flex-direction: column !important;
      gap: 10px;
      width: 100%;
    }
    .apps-grid .app-item {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }
    .app-item {
      background: #F9FAFB;
      border: 1px solid #E5E7EB;
      border-radius: 8px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .app-item .top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 8px;
    }
    .app-item .left {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
      flex: 1;
    }
    .app-item .name {
      font-size: 13px;
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .app-item .badge {
      font-size: 14px;
      flex-shrink: 0;
    }
    .app-item .bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .app-item .sub {
      font-size: 11px;
      color: #6D6D6D;
    }
    .app-item .time {
      font-size: 14px;
      font-weight: 600;
      color: #0097B2;
      flex-shrink: 0;
    }

    /* Session Summary */
    .day-group {
      margin-bottom: 18px;
      border: 1px solid rgba(166,166,166,0.5);
      border-radius: 5px;
      padding: 14px;
      page-break-inside: avoid;
    }
    .day-header {
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 10px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      margin-bottom: 12px;
    }
    thead {
      background: #F9FAFB;
      border-bottom: 1px solid rgba(166,166,166,0.5);
    }
    th {
      text-align: left;
      padding: 8px 10px;
      font-weight: 600;
    }
    td {
      padding: 8px 10px;
      border-bottom: 1px solid rgba(166,166,166,0.15);
    }
    tbody tr:nth-child(even) { background: #E2E2E2; }
    .prod { color: #0097B2; font-weight: 600; }

    .day-totals {
      display: flex;
      gap: 24px;
      padding: 10px 4px 0;
      border-top: 1px solid rgba(166,166,166,0.35);
    }
    .day-totals .item .label {
      font-size: 11px;
      color: #6D6D6D;
    }
    .day-totals .item .value {
      font-size: 14px;
      font-weight: 600;
      color: #0097B2;
    }

    .footer {
      margin-top: 28px;
      padding-top: 14px;
      border-top: 1px solid rgba(166,166,166,0.25);
      text-align: center;
      font-size: 10px;
      color: #6D6D6D;
    }

    .empty {
      font-size: 13px;
      color: #6D6D6D;
      text-align: center;
      padding: 16px 0;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>Detalle de Reporte</h1>
    <div class="period">{{periodStart}} — {{periodEnd}}</div>
  </div>

  <!-- Contractor Info (igual que la vista) -->
  <div class="card contractor-info">
    <div class="avatar">👤</div>
    <div>
      <div class="name">{{contractor.name}}</div>
      <div class="details">
        {{contractor.jobPosition}} | Equipo {{contractor.teamName}} | Cliente {{contractor.clientName}}
        {{#if contractor.country}} | {{contractor.country}}{{/if}}
      </div>
    </div>
  </div>

  <!-- Totales de Entradas — debajo del período, arriba de los gráficos -->
  <div class="card">
    <div class="section-title">Totales de Entradas</div>
    <div class="input-totals-row">
      <div class="input-metric">
        <div class="label">Total de Entradas de Teclado</div>
        <div class="value">{{formatNumber metrics.totalKeyboardInputs}}</div>
      </div>
      <div class="input-metric">
        <div class="label">Total de Entradas de Ratón</div>
        <div class="value">{{formatNumber metrics.totalMouseClicks}}</div>
      </div>
    </div>
  </div>

  <!-- Sesiones y Conectividad -->
  <div class="card">
    <div class="section-title">Sesiones y Conectividad</div>
    <div class="kpi-row">
      <div class="kpi">
        <div class="label">Número de Sesiones</div>
        <div class="value">{{sessionCount}}</div>
      </div>
      <div class="kpi duration">
        <div class="label">Duración Promedio</div>
        <div class="value">{{avgSessionDuration}}</div>
      </div>
      <div class="kpi productivity">
        <div class="label">Productividad Promedio</div>
        <div class="value">{{avgSessionProductivity}}</div>
      </div>
    </div>

    {{#if hasChartData}}
    <div class="charts-grid">
      <div>
        <div class="chart-title">Avg. Duration</div>
        <div class="chart-container">
          <canvas id="durationChart"></canvas>
        </div>
      </div>
      <div>
        <div class="chart-title">Avg. Productivity</div>
        <div class="chart-container">
          <canvas id="productivityChart"></canvas>
        </div>
      </div>
    </div>
    {{else}}
    <div class="empty">Sin datos de gráficos para el período seleccionado</div>
    {{/if}}
  </div>

  <!-- Top Sites & Apps -->
  <div class="card">
    <div class="section-title">Top Sites &amp; Apps</div>
    {{#if topApps.length}}
    <div class="apps-grid">
      {{#each topApps}}
      <div class="app-item">
        <div class="top">
          <div class="left">
            <div class="name">{{appName}}</div>
          </div>
          <div class="badge">{{categoryBadge}}</div>
        </div>
        <div class="bottom">
          <div class="sub">Tiempo de uso</div>
          <div class="time">{{timeLabel}}</div>
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="empty">Sin datos de aplicaciones</div>
    {{/if}}
  </div>

  <!-- Resumen de Sesiones -->
  {{#if hasSessions}}
  <div class="card">
    <div class="section-title">Resumen de Sesiones</div>
    {{#each sessionsByDay}}
    <div class="day-group">
      <div class="day-header">{{session_day}}</div>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Duration</th>
            <th>Active Time</th>
            <th>Idle Time</th>
            <th>Productivity</th>
          </tr>
        </thead>
        <tbody>
          {{#each sessions}}
          <tr>
            <td>{{index}}</td>
            <td>{{session_start}}</td>
            <td>{{session_end}}</td>
            <td>{{durationLabel}}</td>
            <td>{{activeLabel}}</td>
            <td>{{idleLabel}}</td>
            <td class="prod">{{productivity_score}}%</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      <div class="day-totals">
        <div class="item">
          <div class="label">Total Session</div>
          <div class="value">{{totals.count}}</div>
        </div>
        <div class="item">
          <div class="label">Total Avg. Duration</div>
          <div class="value">{{totals.avgDuration}}</div>
        </div>
        <div class="item">
          <div class="label">Total Avg. Productivity</div>
          <div class="value">{{totals.avgProductivity}}</div>
        </div>
      </div>
    </div>
    {{/each}}
  </div>
  {{/if}}

  <div class="footer">
    Generado el {{generatedAt}} | Environment: {{summary.environment}}
  </div>

  {{#if hasChartData}}
  <script>
    (function () {
      var labels = {{{chartLabels}}};
      var durationValues = {{{durationChartValues}}};
      var productivityValues = {{{productivityChartValues}}};

      function fmtMinutes(mins) {
        var m = Math.round(mins || 0);
        if (m >= 60) {
          var h = Math.floor(m / 60);
          var rem = m % 60;
          return h + 'h ' + rem + 'm';
        }
        return m + 'm';
      }

      var durationCtx = document.getElementById('durationChart');
      if (durationCtx) {
        new Chart(durationCtx, {
          type: 'line',
          data: {
            labels: labels,
            datasets: [{
              label: 'Avg. Duration',
              data: durationValues,
              borderColor: '#0097B2',
              backgroundColor: 'rgba(0, 151, 178, 0.15)',
              borderWidth: 2,
              fill: true,
              tension: 0.35,
              pointRadius: 3,
              pointBackgroundColor: '#0097B2',
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: false,
            layout: {
              padding: { top: 4, right: 16, bottom: 0, left: 0 }
            },
            plugins: {
              legend: { display: true, position: 'bottom' },
              tooltip: {
                callbacks: {
                  label: function (ctx) { return 'Avg. Duration: ' + fmtMinutes(ctx.parsed.y); }
                }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                max: 60,
                ticks: {
                  callback: function (v) { return v + 'm'; }
                }
              },
              x: {
                ticks: { maxRotation: 45, autoSkip: true, maxTicksLimit: 12 }
              }
            }
          }
        });
      }

      var productivityCtx = document.getElementById('productivityChart');
      if (productivityCtx) {
        new Chart(productivityCtx, {
          type: 'line',
          data: {
            labels: labels,
            datasets: [{
              label: 'Avg. Productivity',
              data: productivityValues,
              borderColor: '#7DA40A',
              backgroundColor: 'rgba(125, 164, 10, 0.15)',
              borderWidth: 2,
              fill: true,
              tension: 0.35,
              pointRadius: 3,
              pointBackgroundColor: '#7DA40A',
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: false,
            layout: {
              padding: { top: 4, right: 16, bottom: 0, left: 0 }
            },
            plugins: {
              legend: { display: true, position: 'bottom' },
              tooltip: {
                callbacks: {
                  label: function (ctx) { return 'Avg. Productivity: ' + Math.round(ctx.parsed.y) + '%'; }
                }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                max: 100,
                ticks: {
                  callback: function (v) { return v + '%'; }
                }
              },
              x: {
                ticks: { maxRotation: 45, autoSkip: true, maxTicksLimit: 12 }
              }
            }
          }
        });
      }
    })();
  </script>
  {{/if}}
</body>
</html>
